<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.YinlepingfenDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.YinlepingfenEntity" id="yinlepingfenMap">
        <result property="songname" column="songname"/>
        <result property="yinleleixing" column="yinleleixing"/>
        <result property="singer" column="singer"/>
        <result property="pingfen" column="pingfen"/>
        <result property="pingfenriqi" column="pingfenriqi"/>
        <result property="yonghuzhanghao" column="yonghuzhanghao"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.YinlepingfenView" >

		SELECT  yinlepingfen.* FROM yinlepingfen  yinlepingfen 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.YinlepingfenView" >
		SELECT * FROM yinlepingfen  yinlepingfen <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
